{
  "name": "woonuxt",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "dev:ssl": "NODE_TLS_REJECT_UNAUTHORIZED=0 nuxt dev --https --ssl-cert localhost.pem --ssl-key localhost-key.pem",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "serve": "nuxi generate && npx serve .output/public -l 8080",
    "build:app": "nuxt generate && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.0",
    "@capacitor/core": "^7.4.0",
    "@capacitor/ios": "^7.4.0",
    "@stripe/stripe-js": "^4.10.0",
    "@vueform/slider": "^2.1.10",
    "@vueuse/core": "^13.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@nuxt/icon": "^1.13.0",
    "@nuxt/image": "1.10.0",
    "@nuxtjs/i18n": "^9.5.5",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tailwindcss/typography": "^0.5.16",
    "nuxt": "^3.17.5",
    "nuxt-graphql-client": "^0.2.46",
    "prettier": "^3.5.3",
    "woonuxt-settings": "^1.2.1"
  },
  "overrides": {
    "sharp": "0.32.6"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.43.0"
  }
}
